# Cloud Deployment Environment Profile
# DO NOT COMMIT THIS FILE WITH REAL VALUES

APP_ENV=production
APP_MODE=cloud
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-custom-domain.com

# Database (PostgreSQL - Neon, Supabase, etc.)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# Storage (Cloudflare R2)
STORAGE_BACKEND=r2
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=autotube-assets
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# Workers (GitHub Actions)
WORKER_BACKEND=github_actions
GITHUB_TOKEN=your_github_pat_token
GITHUB_REPOSITORY=Sagolsa78/AutoTube_AI

# Authentication (Supabase / custom)
AUTH_DISABLED=false
AUTOTUBE_API_KEY=your_secure_api_key

# AI Providers
SCRIPT_PROVIDER_ORDER=gemini,groq,openrouter
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key

# Stock Footage
PEXELS_API_KEY=your_pexels_key
