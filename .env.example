# ── AI Providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Ollama base URL (local — no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2          # change to any model you have pulled

# ── Stock Footage ─────────────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_key_here
PIXABAY_API_KEY=your_pixabay_key_here

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# Path to the client_secret.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=client_secret.json

# ── App Config ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./storage/autoshorts.db
STORAGE_ROOT=./storage
LOG_LEVEL=INFO
APP_ENV=development                # development | production

# ── Script Provider Priority ──────────────────────────────────────────────────
# Comma-separated order the fallback chain tries: ollama,gemini,groq,openrouter
SCRIPT_PROVIDER_ORDER=ollama,gemini,groq,openrouter
