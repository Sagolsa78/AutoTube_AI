# Local Development Environment Profile
# Copy to .env and adjust as needed

APP_ENV=development
APP_MODE=local
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Database (Local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./storage/autoshorts.db

# Storage (Local Filesystem)
STORAGE_BACKEND=local
STORAGE_ROOT=storage

# Workers
WORKER_BACKEND=local
DAILY_GPU_BUDGET_CAP=2.00

# Authentication (Disabled for local dev by default)
AUTH_DISABLED=true

# AI Providers
SCRIPT_PROVIDER_ORDER=ollama,gemini,groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# GEMINI_API_KEY=your_gemini_key
# GROQ_API_KEY=your_groq_key

# Stock Footage
# PEXELS_API_KEY=your_pexels_key
# PIXABAY_API_KEY=your_pixabay_key
